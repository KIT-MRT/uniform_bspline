# ---------------------------------------------------------------------------
# Doxygen configuration for uniform_bspline
#
# Generate HTML docs:
#   mkdir -p build/docs && doxygen Doxyfile
# Output: build/docs/html/index.html
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Project
# ---------------------------------------------------------------------------
PROJECT_NAME           = "uniform_bspline"
PROJECT_NUMBER         = 1.1.0
PROJECT_BRIEF          = "A uniform B-spline implementation: R^n -> R^m"
OUTPUT_DIRECTORY       = build/docs

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
INPUT                  = include/uniform_bspline \
                         docs/mainpage.md
RECURSIVE              = YES
FILE_PATTERNS          = *.hpp *.h *.md
EXTENSION_MAPPING      = hpp=C++

# Snippets are pulled from the C++ test sources.
EXAMPLE_PATH           = tests/cpp tests/python bindings/python
EXAMPLE_PATTERNS       = *.cpp

# Use the README as the Doxygen main page.
USE_MDFILE_AS_MAINPAGE = docs/mainpage.md

# ---------------------------------------------------------------------------
# Output formats
# ---------------------------------------------------------------------------
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_OUTPUT            = html

# ---------------------------------------------------------------------------
# Extraction
# ---------------------------------------------------------------------------
EXTRACT_ALL            = NO
EXTRACT_PRIVATE        = YES
EXTRACT_STATIC         = YES

# ---------------------------------------------------------------------------
# Math rendering (MathJax — no LaTeX installation required)
# ---------------------------------------------------------------------------
USE_MATHJAX            = YES
MATHJAX_VERSION        = MathJax_3
EXTRA_PACKAGES         = blkarray amssymb amsmath

# ---------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------
PREDEFINED             = DOXYGEN
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES

# ---------------------------------------------------------------------------
# Warnings
# ---------------------------------------------------------------------------
WARN_IF_UNDOCUMENTED   = NO
QUIET                  = NO
